{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@shared/*": [
        "./shared/*"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "electron/**/*.ts",
    "shared/**/*.ts",
    "test/**/*.ts",
    "tools/**/*.ts",
    "electron.vite.config.ts",
    "resources/interview-bank/*.json"
  ],
  "exclude": [
    "test/micCapture.spec.ts"
  ]
}
